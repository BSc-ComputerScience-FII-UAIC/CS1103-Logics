  "definitions": [
    {
      "term": "proposition",
      "definition": "A statement that can be true or false."
    },
    {
      "term": "logical connective",
      "definition": "An operator such as 'and', 'or', 'not', 'implies', 'if and only if' that combines propositions."
    },
    {
      "term": "tautology",
      "definition": "A proposition that is true in every possible interpretation."
    },
    {
      "term": "modus ponens",
      "definition": "The inference rule: from P and P→Q, conclude Q."
    },
    {
      "term": "modus tollens",
      "definition": "The inference rule: from ¬Q and P→Q, conclude ¬P."
    }
  ],
